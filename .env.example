# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Production Environment Settings
NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-long-random-production-secret

# Initial/seed superadmin credentials. Use strong, private values in real environments.
INITIAL_SUPERADMIN_EMAIL=admin@example.com
INITIAL_SUPERADMIN_PASSWORD=replace-with-strong-password
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=replace-with-strong-password

# Local development uses database.sqlite.
# Production currently uses Azure SQL / Microsoft SQL Server.
DB_SERVER=your-sql-server.database.windows.net
DB_NAME=contact_center
DB_USER=sql_user
DB_PASSWORD=sql_password
DB_PORT=1433

# Public frontend URL used in password setup links.
# Example: https://contact-center-app.azurewebsites.net
APP_PUBLIC_URL=https://your-app.azurewebsites.net

# Password setup email delivery.
# This app sends emails through a secure HTTP webhook (Azure Logic App, Power Automate,
# Azure Function, SendGrid webhook proxy, etc.). The webhook must accept JSON:
# { "to", "subject", "text", "html" }
EMAIL_INVITE_WEBHOOK_URL=https://your-email-webhook-url
EMAIL_WEBHOOK_SECRET=optional-shared-secret
PASSWORD_SETUP_TOKEN_TTL_HOURS=24

# ---------------------------------------------------------------------------
# Performance tuning (all optional - the defaults are what production runs on)
# ---------------------------------------------------------------------------
# Connection pool for Azure SQL. `max` caps how many queries this instance can
# run at once; everything beyond it queues. Keep the total across all App
# Service instances comfortably under what the database tier allows
# (Standard S0 permits roughly 60 concurrent workers).
DB_POOL_MIN=2
DB_POOL_MAX=20
# Fail fast rather than letting a request wait a full minute for a free
# connection during a burst.
DB_POOL_ACQUIRE_TIMEOUT_MS=15000
DB_POOL_CREATE_TIMEOUT_MS=30000
DB_POOL_IDLE_TIMEOUT_MS=60000
DB_REQUEST_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=30000

# How long GET /api/slots (the most-polled endpoint) may serve a shared
# cached copy of the schedule. Any booking or schedule edit clears the cache
# immediately, so this never delays a real change - it only collapses
# identical simultaneous reads.
SLOTS_CACHE_TTL_MS=5000

# How long the authenticate middleware may reuse a cached user row instead of
# re-reading it on every single request. Role changes, deactivations and
# deletions clear it immediately.
AUTH_USER_CACHE_TTL_MS=15000
